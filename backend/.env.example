# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Feature Flags & Dev Overrides
DISABLE_DB=false
DISABLE_CACHE=false
RUN_WORKERS_IN_PROCESS=true

# Database Configuration (PostgreSQL / Aiven / Supabase)
# SQLite fallback: sqlite:///./joblens.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joblens
JOB_STALE_AFTER_DAYS=14

# LLM Configuration
# --- Provider selection ---
# Supported values: "ollama" | "freemodel" | "openai" | "groq" | "gemini"
LLM_PROVIDER_DEFAULT=freemodel
# Legacy single-provider fallback key:
LLM_PROVIDER=freemodel

# --- Per-role provider overrides (leave blank to use LLM_PROVIDER_DEFAULT) ---
# rationale   — fit rationale generation (cheap, frequent; speed matters more than structure)
LLM_PROVIDER_RATIONALE=
# gap_analysis — JD extraction, bridge suggestions, gap report (structured JSON; accuracy first)
LLM_PROVIDER_GAP_ANALYSIS=
# resume_parsing — resume text extraction
LLM_PROVIDER_RESUME_PARSING=
# notification  — teaser text in notifications
LLM_PROVIDER_NOTIFICATION=

# FreeModel.dev (OpenAI-compatible)
FREEMODEL_API_KEY=your_freemodel_api_key_here
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1
FREEMODEL_MODEL=gpt-5.4-mini

# Groq — fast/cheap OpenAI-compatible inference (https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini — Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (used when provider is "ollama")
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3
LLAMA_API_BASE=http://127.0.0.1:11434
LLAMA_MODEL=llama3.2:latest

# Match & Rationale Settings
TOP_N_RATIONALES=10

# Aggregator API keys
# Adzuna: free tier keys at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
DEFAULT_JOB_LOCATION=
ADZUNA_ENABLED=true

# Jooble: free API key at https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_ENABLED=true

REMOTIVE_ENABLED=true
ARBEITNOW_ENABLED=true

# Minimum minutes between resume-driven live searches
LIVE_SEARCH_MIN_INTERVAL_MINUTES=15
JOBS_PER_USER_ROTATION_BATCH_SIZE=3

# Redis Configuration (Supports full REDIS_URL or host/port/password components)
# e.g., REDIS_URL="rediss://default:password@host:port" or "redis://localhost:6379"
REDIS_URL=
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
EMBEDDING_STREAM_MAXLEN=10000
EMBEDDING_MAX_RETRIES=3

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@joblens.ai

# WhatsApp Configuration
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Notification settings
MAX_NOTIFS_PER_HOUR=5

# Frontend URL — used for CORS allowed origins and notification deep-links
FRONTEND_URL=http://localhost:5173

# Self-Serve Onboarding Invite Code Protection
SIGNUP_INVITE_TOKEN=joblens-beta-2026

# JWT Authentication Settings
# REQUIRED: Generate a 32+ character random hex string:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Cloudinary Storage Configuration & Resume Settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESUME_MAX_SIZE_MB=5
RESUME_PROCESSING_MAX_RETRIES=3

# OCR Settings
OCR_MAX_PAGES=5
OCR_TIMEOUT_SECONDS=60