# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/joblens

# LLM Configuration
# --- Default provider (used when a role-specific override below is left blank) ---
# Supported values: "ollama" | "freemodel" | "openai" | "groq" | "gemini"
# Legacy note: the old LLM_PROVIDER is still read as a fallback for LLM_PROVIDER_DEFAULT
# so existing .env files continue to work without any changes.
LLM_PROVIDER_DEFAULT=ollama

# --- Per-role provider overrides (leave blank to use LLM_PROVIDER_DEFAULT) ---
# rationale   — fit rationale generation (cheap, frequent; speed matters more than structure)
LLM_PROVIDER_RATIONALE=
# gap_analysis — JD extraction, bridge suggestions, gap report (structured JSON; accuracy first)
LLM_PROVIDER_GAP_ANALYSIS=
# resume_parsing — resume text extraction (same needs as gap_analysis)
LLM_PROVIDER_RESUME_PARSING=
# notification  — teaser text in notifications (cheap, low-stakes)
LLM_PROVIDER_NOTIFICATION=

# Ollama (used when provider is "ollama")
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3

# FreeModel.dev (used when provider is "freemodel")
# FREEMODEL_API_KEY=
# FREEMODEL_BASE_URL=https://api.freemodel.dev/v1
# FREEMODEL_MODEL=auto

# Groq — fast/cheap OpenAI-compatible inference (https://console.groq.com/)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — Google structured JSON extraction (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Aggregator API keys
# Adzuna: free tier keys at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
DEFAULT_JOB_LOCATION=

ADZUNA_ENABLED=true
REMOTIVE_ENABLED=true
ARBEITNOW_ENABLED=true

# Jooble: free API key at https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_ENABLED=true

# Minimum minutes between resume-driven live searches (debounce for free-tier API quotas)
LIVE_SEARCH_MIN_INTERVAL_MINUTES=15

# Redis — connection is built from individual components (not REDIS_URL) to
# avoid python-dotenv's unreliable ${VAR} interpolation inside .env files.
# All four vars are required when running via docker-compose; the compose
# file will fail to start if REDIS_PASSWORD is unset.
REDIS_PASSWORD=changeme            # REQUIRED — must match docker-compose value
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@joblens.ai

# WhatsApp Configuration
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Notification settings
MAX_NOTIFS_PER_HOUR=5

# Frontend URL — used for CORS allowed origins and notification deep-links.
# Supports comma-separated values for multi-origin setups:
#   FRONTEND_URL=http://localhost:5173,https://joblens.example.com
FRONTEND_URL=http://localhost:5173

# Self-Serve Onboarding Invite Code Protection
# IMPORTANT: Change SIGNUP_INVITE_TOKEN to a secure secret in .env before any real deployment!
SIGNUP_INVITE_TOKEN=joblens-beta-2026

# Top N matches to generate rationales for
TOP_N_RATIONALES=10

# Cloudinary Storage Configuration (Signed/Authenticated Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESUME_MAX_SIZE_MB=5
RESUME_PROCESSING_MAX_RETRIES=3